{
  "name": "company-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Garment ERP — Cutting / Stretching / QC / Packing (Tamil-first, local network server)",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "migrate": "npm run migrate --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "engines": {
    "node": ">=20"
  }
}
