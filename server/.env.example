# SQLite database file (kept in the server folder by default)
DATABASE_URL="file:./data/erp.db"

# HTTP port the local network server listens on
PORT=4000
# Bind to 0.0.0.0 so other devices on the WiFi can reach it
HOST=0.0.0.0

# --- Daily backup ---
# Cron time for the daily backup (server local time). Default 22:30.
BACKUP_CRON="30 22 * * *"
# How many local backup files to keep
BACKUP_RETENTION=30

# --- Telegram backup delivery (from @BotFather) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
